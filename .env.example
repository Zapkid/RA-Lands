# Copy to .env.local for local development; set the same names in Vercel.
# Never commit real values.

# --- Public site settings ---
# Canonical site URL (used for metadata, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://ralandinvestments.com

# --- Supabase (listings, admin login, photos) ---
# Both values come from the new Supabase project: Settings > API.
# The publishable key is safe to expose; access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Forms: SMTP2GO (contact, property inquiries, newsletter) ---
SMTP2GO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@ralandinvestments.com
CONTACT_FROM_NAME=RA Lands Website

# --- Preview only ---
# Show clearly-labelled sample parcels in a production build that has no
# Supabase yet. Leave unset in real production.
# NEXT_PUBLIC_USE_SAMPLE_PARCELS=1
